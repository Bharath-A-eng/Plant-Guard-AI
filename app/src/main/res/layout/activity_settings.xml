<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ================= HEADER ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp"
            android:background="@drawable/header_background">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️"
                android:textSize="34sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/settings"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/white" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Customize your PlantGuard AI experience"
                android:textSize="14sp"
                android:textColor="@color/headerLight" />

        </LinearLayout>


        <!-- ================= GENERAL SECTION ================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="General"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/textBlack"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="10dp" />


        <!-- ================= LANGUAGE ================= -->

        <Button
            android:id="@+id/btnLanguage"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/language"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="@drawable/settings_button"
            android:layout_marginBottom="10dp" />


        <!-- ================= DARK MODE ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="14dp"
            android:background="@drawable/google_button">

            <!-- Text Section -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtDarkMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌙  Dark Mode"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/textBlack" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Switch between light and dark appearance"
                    android:textSize="12sp"
                    android:textColor="@color/gray" />

            </LinearLayout>


            <!-- Dark Mode Switch -->

            <Switch
                android:id="@+id/switchDarkMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Dark Mode Switch" />

        </LinearLayout>


        <!-- ================= SUPPORTED PLANTS ================= -->

        <Button
            android:id="@+id/btnPlants"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/supported_plants"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="@drawable/settings_button"
            android:layout_marginBottom="10dp" />


        <!-- ================= SCAN HISTORY ================= -->

        <Button
            android:id="@+id/btnHistory"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/scan_history"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="@drawable/settings_button"
            android:layout_marginBottom="10dp" />


        <!-- ================= APPLICATION SECTION ================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Application"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/textBlack"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="10dp" />


        <!-- ================= ABOUT ================= -->

        <Button
            android:id="@+id/btnAbout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/about_app"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="@drawable/settings_button"
            android:layout_marginBottom="10dp" />


        <!-- ================= SHARE ================= -->

        <Button
            android:id="@+id/btnShare"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/share_app"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="@drawable/settings_button"
            android:layout_marginBottom="10dp" />


        <!-- ================= RATE ================= -->

        <Button
            android:id="@+id/btnRate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/rate_app"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="@drawable/settings_button"
            android:layout_marginBottom="10dp" />


        <!-- ================= PRIVACY ================= -->

        <Button
            android:id="@+id/btnPrivacy"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/privacy_policy"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="@drawable/settings_button"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>