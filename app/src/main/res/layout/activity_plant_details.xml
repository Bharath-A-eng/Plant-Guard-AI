<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="30dp">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌿"
                android:textSize="42sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Plant Information"
                android:textColor="@color/primaryGreen"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Disease details and plant care guide"
                android:textColor="@color/gray"
                android:textSize="14sp" />

        </LinearLayout>


        <!-- PLANT CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="20dp"
            android:background="@drawable/card_background">

            <ImageView
                android:id="@+id/imgPlant"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:src="@drawable/apple"
                android:contentDescription="@string/plant_image"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/txtPlantName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/apple"
                android:textColor="@color/primaryGreen"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Plant Disease &amp; Care Information"
                android:textColor="@color/gray"
                android:textSize="14sp" />

        </LinearLayout>


        <!-- SUPPORTED DISEASES CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:padding="18dp"
            android:background="@drawable/card_background">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🦠  Supported Diseases"
                android:textColor="@color/textBlack"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:layout_width="45dp"
                android:layout_height="3dp"
                android:layout_marginTop="8dp"
                android:background="@color/primaryGreen" />

            <TextView
                android:id="@+id/txtDiseases"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/apple_diseases"
                android:textColor="@color/textBlack"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>


        <!-- CARE TIPS CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp"
            android:padding="18dp"
            android:background="@drawable/card_background">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌱  Care Tips"
                android:textColor="@color/textBlack"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:layout_width="45dp"
                android:layout_height="3dp"
                android:layout_marginTop="8dp"
                android:background="@color/primaryGreen" />

            <TextView
                android:id="@+id/txtCare"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/sample_care"
                android:textColor="@color/textBlack"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>


        <!-- PREVENTION CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp"
            android:padding="18dp"
            android:background="@drawable/card_background">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️  Prevention"
                android:textColor="@color/textBlack"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:layout_width="45dp"
                android:layout_height="3dp"
                android:layout_marginTop="8dp"
                android:background="@color/primaryGreen" />

            <TextView
                android:id="@+id/txtPrevention"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/sample_prevention"
                android:textColor="@color/textBlack"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>


        <!-- TREATMENT CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp"
            android:padding="18dp"
            android:background="@drawable/card_background">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💊  Treatment"
                android:textColor="@color/textBlack"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:layout_width="45dp"
                android:layout_height="3dp"
                android:layout_marginTop="8dp"
                android:background="@color/primaryGreen" />

            <TextView
                android:id="@+id/txtTreatment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp"
                android:text="@string/sample_treatment"
                android:textColor="@color/textBlack"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>