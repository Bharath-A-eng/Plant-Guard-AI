<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="30dp">


        <!-- ===================================================== -->
        <!-- ======================= HEADER ====================== -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/header_green_background">

            <!-- Header Icon -->

            <TextView
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:gravity="center"
                android:text="🌱"
                android:textSize="32sp"
                android:background="@drawable/header_icon_background" />

            <!-- App Name -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/app_name"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/white" />

            <!-- Smart Plant Monitoring -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/smart_plant_monitoring"
                android:textSize="15sp"
                android:textColor="#D6EAD8" />

            <!-- Divider -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="#33FFFFFF" />

            <!-- Home Subtitle -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/home_subtitle"
                android:textSize="15sp"
                android:textColor="#E5F2E7"
                android:lineSpacingExtra="3dp" />

            <!-- System Monitoring Status -->

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/status_dot" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/system_monitoring_active"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#DFF5E2" />

            </LinearLayout>

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- ================= PLANT ENVIRONMENT ================= -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="12dp"
            android:text="@string/plant_environment"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="@color/textBlack" />


        <!-- ===================================================== -->
        <!-- ====================== PLANT 1 ====================== -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/card_background">

            <!-- Plant 1 Header -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- PLANT 1 IMAGE -->

                <ImageView
                    android:id="@+id/imgPlant1"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/apple"
                    android:background="@drawable/header_icon_background" />


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Plant 1"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/textBlack" />

                    <Spinner
                        android:id="@+id/spinnerPlant1"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/google_button" />

                </LinearLayout>

            </LinearLayout>


            <!-- Divider -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="14dp"
                android:background="@color/border" />


            <!-- ================================================= -->
            <!-- Temperature + Humidity -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Temperature -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/temperature"
                        android:textSize="13sp"
                        android:textColor="@color/gray" />

                    <TextView
                        android:id="@+id/txtTemperature1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="28.4°C"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/primaryGreen" />

                </LinearLayout>


                <!-- Humidity -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/humidity"
                        android:textSize="13sp"
                        android:textColor="@color/gray" />

                    <TextView
                        android:id="@+id/txtHumidity1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="72%"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/primaryGreen" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- Soil Moisture + Light -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <!-- Soil Moisture -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/soil_moisture"
                        android:textSize="13sp"
                        android:textColor="@color/gray" />

                    <TextView
                        android:id="@+id/txtSoilMoisture1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="61%"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/primaryGreen" />

                </LinearLayout>


                <!-- Light -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/light_level"
                        android:textSize="13sp"
                        android:textColor="@color/gray" />

                    <TextView
                        android:id="@+id/txtLightLevel1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/good"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/primaryGreen" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- Water Pump -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="🚰"
                    android:textSize="24sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/water_pump"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/textBlack" />

                    <TextView
                        android:id="@+id/txtPumpStatus1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/off"
                        android:textSize="13sp"
                        android:textColor="@color/gray" />

                </LinearLayout>

                <Switch
                    android:id="@+id/switchPump1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- ====================== PLANT 2 ====================== -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/card_background">

            <!-- Plant 2 Header -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- PLANT 2 IMAGE -->

                <ImageView
                    android:id="@+id/imgPlant2"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/tomato"
                    android:background="@drawable/header_icon_background" />


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Plant 2"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/textBlack" />

                    <Spinner
                        android:id="@+id/spinnerPlant2"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/google_button" />

                </LinearLayout>

            </LinearLayout>


            <!-- Divider -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="14dp"
                android:background="@color/border" />


            <!-- ================================================= -->
            <!-- Temperature + Humidity -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Temperature -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/temperature"
                        android:textSize="13sp"
                        android:textColor="@color/gray" />

                    <TextView
                        android:id="@+id/txtTemperature2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="27.8°C"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/primaryGreen" />

                </LinearLayout>


                <!-- Humidity -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/humidity"
                        android:textSize="13sp"
                        android:textColor="@color/gray" />

                    <TextView
                        android:id="@+id/txtHumidity2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="68%"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/primaryGreen" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- Soil Moisture + Light -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <!-- Soil Moisture -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/soil_moisture"
                        android:textSize="13sp"
                        android:textColor="@color/gray" />

                    <TextView
                        android:id="@+id/txtSoilMoisture2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="43%"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/primaryGreen" />

                </LinearLayout>


                <!-- Light -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/light_level"
                        android:textSize="13sp"
                        android:textColor="@color/gray" />

                    <TextView
                        android:id="@+id/txtLightLevel2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/low"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/primaryGreen" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- Water Pump -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="🚰"
                    android:textSize="24sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/water_pump"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/textBlack" />

                    <TextView
                        android:id="@+id/txtPumpStatus2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/off"
                        android:textSize="13sp"
                        android:textColor="@color/gray" />

                </LinearLayout>

                <Switch
                    android:id="@+id/switchPump2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- ==================== QUICK ACTIONS ================= -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="12dp"
            android:text="@string/quick_actions"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="@color/textBlack" />


        <!-- Scan Plant -->

        <Button
            android:id="@+id/btnScan"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/scan_button"
            android:text="@string/scan_plant"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false" />


        <!-- History -->

        <Button
            android:id="@+id/btnHistory"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/action_button"
            android:text="@string/history"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false" />


        <!-- Settings -->

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/action_button"
            android:text="@string/settings"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false" />


        <!-- Logout -->

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/logout_button"
            android:text="@string/logout"
            android:textColor="@color/danger"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false" />

    </LinearLayout>

</ScrollView>