<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed state -->
    <item android:state_pressed="true">

        <shape>
            <solid android:color="#4E3F88" />

            <corners
                android:radius="20dp" />
        </shape>

    </item>

    <!-- Normal state -->
    <item>

        <shape>
            <solid android:color="#66579A" />

            <corners
                android:radius="20dp" />
        </shape>

    </item>

</selector>