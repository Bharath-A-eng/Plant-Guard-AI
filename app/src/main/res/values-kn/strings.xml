    <!-- ========================================================= -->

    <string name="orange_care">
        • ಆಳವಾಗಿ ನೀರು ಹಾಕಿ\n• ಪ್ರತಿ ಋತುವಿನಲ್ಲಿ ಗೊಬ್ಬರ ಹಾಕಿ\n• ಸಾಕಷ್ಟು ಸೂರ್ಯನ ಬೆಳಕು ಒದಗಿಸಿ
    </string>

    <string name="orange_prevention">
        • ನಿಯಮಿತವಾಗಿ ಪರಿಶೀಲಿಸಿ\n• ಕೀಟಗಳನ್ನು ನಿಯಂತ್ರಿಸಿ\n• ಸೋಂಕಿತ ಕೊಂಬೆಗಳನ್ನು ತೆಗೆದುಹಾಕಿ
