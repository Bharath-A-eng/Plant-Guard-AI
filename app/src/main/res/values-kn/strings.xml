    <!-- ========================================================= -->
    <!-- APPLE -->
    <!-- ========================================================= -->

    <string name="apple_care">
        • ಸೋಂಕಿತ ಎಲೆಗಳು ಮತ್ತು ಕೊಂಬೆಗಳನ್ನು ತೆಗೆದುಹಾಕಿ\n• ಮರದ ಸುತ್ತ ಉತ್ತಮ ಗಾಳಿಯ ಹರಿವು ಇರುವಂತೆ ನೋಡಿಕೊಳ್ಳಿ\n• ಅಗತ್ಯವಿದ್ದಾಗ ಮಾತ್ರ ನೀರು ಹಾಕಿ
    </string>

    <string name="apple_prevention">
        • ಬಿದ್ದ ಎಲೆಗಳನ್ನು ತೆಗೆದುಹಾಕಿ\n• ಮರಗಳ ನಡುವೆ ಸೂಕ್ತ ಅಂತರವನ್ನು ಕಾಪಾಡಿ\n• ರೋಗ ನಿರೋಧಕ ತಳಿಗಳನ್ನು ಬಳಸಿ
    </string>

    <string name="apple_treatment">
        • ತಾಮ್ರ ಆಧಾರಿತ ಶಿಲೀಂಧ್ರನಾಶಕವನ್ನು ಸಿಂಪಡಿಸಿ\n• ಗಂಧಕ (Sulfur) ಸಿಂಪಡಣೆ ಮಾಡಿ\n• ಸೋಂಕಿತ ಕೊಂಬೆಗಳನ್ನು ಕತ್ತರಿಸಿ ತೆಗೆದುಹಾಕಿ
    </string>


    <!-- ========================================================= -->
    <!-- BLUEBERRY -->
    <!-- ========================================================= -->

    <string name="blueberry_care">
        • ಮಣ್ಣಿನ ಆಮ್ಲೀಯತೆಯನ್ನು ಕಾಪಾಡಿ\n• ನಿಯಮಿತವಾಗಿ ನೀರು ಹಾಕಿ\n• ಸಸ್ಯದ ಸುತ್ತ ಮಲ್ಚ್ ಹಾಸಿ
    </string>

    <string name="blueberry_prevention">
        • ನೀರು ನಿಲ್ಲದಂತೆ ನೋಡಿಕೊಳ್ಳಿ\n• ಸೋಂಕಿತ ಕೊಂಬೆಗಳನ್ನು ತೆಗೆದುಹಾಕಿ\n• ಸರಿಯಾದ ಅಂತರವನ್ನು ಕಾಪಾಡಿ
    </string>

    <string name="blueberry_treatment">
        • ಸೋಂಕಿತ ಎಲೆಗಳನ್ನು ತೆಗೆದುಹಾಕಿ\n• ಅಗತ್ಯವಿದ್ದರೆ ಶಿಲೀಂಧ್ರನಾಶಕ ಬಳಸಿ\n• ನೀರು ಹೊರಹೋಗುವ ವ್ಯವಸ್ಥೆಯನ್ನು ಸುಧಾರಿಸಿ
    </string>


    <!-- ========================================================= -->
    <!-- CHERRY -->
    <!-- ========================================================= -->

    <string name="cherry_care">
        • ಬೇಸಿಗೆಯಲ್ಲಿ ನಿಯಮಿತವಾಗಿ ನೀರು ಹಾಕಿ\n• ಪ್ರತಿ ವರ್ಷ ಕೊಂಬೆಗಳನ್ನು ಕತ್ತರಿಸಿ\n• ಸಾಕಷ್ಟು ಸೂರ್ಯನ ಬೆಳಕು ಒದಗಿಸಿ
    </string>

    <string name="cherry_prevention">
        • ಬಿದ್ದ ಎಲೆಗಳನ್ನು ಸ್ವಚ್ಛಗೊಳಿಸಿ\n• ಮೇಲಿನಿಂದ ನೀರು ಹಾಕುವುದನ್ನು ತಪ್ಪಿಸಿ\n• ಕೀಟಗಳಿಗಾಗಿ ನಿಯಮಿತವಾಗಿ ಪರಿಶೀಲಿಸಿ
    </string>

    <string name="cherry_treatment">
        • ಶಿಫಾರಸು ಮಾಡಿದ ಶಿಲೀಂಧ್ರನಾಶಕ ಬಳಸಿ\n• ಸೋಂಕಿತ ಕೊಂಬೆಗಳನ್ನು ತೆಗೆದುಹಾಕಿ\n• ಸಸ್ಯವನ್ನು ನಿಯಮಿತವಾಗಿ ಪರಿಶೀಲಿಸಿ
    </string>


    <!-- ========================================================= -->
    <!-- CORN -->
    <!-- ========================================================= -->

    <string name="corn_care">
        • ನಿಯಮಿತವಾಗಿ ನೀರು ಹಾಕಿ\n• ನೈಟ್ರೋಜನ್ ಗೊಬ್ಬರ ಬಳಸಿ\n• ಕಳೆಗಳನ್ನು ತೆಗೆದುಹಾಕಿ
    </string>

    <string name="corn_prevention">
        • ಬೆಳೆ ಪರಿವರ್ತನೆ ಮಾಡಿ\n• ಸೋಂಕಿತ ಸಸಿಗಳನ್ನು ತೆಗೆದುಹಾಕಿ\n• ಗುಣಮಟ್ಟದ ಬೀಜಗಳನ್ನು ಬಳಸಿ
    </string>

    <string name="corn_treatment">
        • ಶಿಫಾರಸು ಮಾಡಿದ ಶಿಲೀಂಧ್ರನಾಶಕ ಬಳಸಿ\n• ಸೋಂಕಿತ ಎಲೆಗಳನ್ನು ತೆಗೆದುಹಾಕಿ\n• ಹೊಲವನ್ನು ಸ್ವಚ್ಛವಾಗಿಡಿ
    </string>


    <!-- ========================================================= -->
    <!-- GRAPE -->
    <!-- ========================================================= -->

    <string name="grape_care">
        • ಪ್ರತಿ ವರ್ಷ ಲತೆಯನ್ನು ಕತ್ತರಿಸಿ\n• ಬೆಂಬಲ ವ್ಯವಸ್ಥೆ ಒದಗಿಸಿ\n• ಅತಿಯಾಗಿ ನೀರು ಹಾಕಬೇಡಿ
    </string>

    <string name="grape_prevention">
        • ಉತ್ತಮ ಗಾಳಿಯ ಹರಿವನ್ನು ಕಾಪಾಡಿ\n• ಎಲೆಗಳು ಒದ್ದೆಯಾಗದಂತೆ ನೋಡಿಕೊಳ್ಳಿ\n• ಸೋಂಕಿತ ಲತೆಯನ್ನು ತೆಗೆದುಹಾಕಿ
    </string>

    <string name="grape_treatment">
        • ತಾಮ್ರ ಆಧಾರಿತ ಶಿಲೀಂಧ್ರನಾಶಕ ಬಳಸಿ\n• ಸೋಂಕಿತ ಲತೆಯನ್ನು ತೆಗೆದುಹಾಕಿ\n• ಹಾನಿಗೊಳಗಾದ ಚಿಗುರುಗಳನ್ನು ಕತ್ತರಿಸಿ
    </string>


